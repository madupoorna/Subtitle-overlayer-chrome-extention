{
  "manifest_version": 3,
  "name": "Universal Subtitle Overlay",
  "version": "1.1",
  "permissions": ["activeTab", "scripting", "storage"],
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ]
}